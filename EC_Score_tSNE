library(Seurat)
library(SCP)
library(ggplot2)
library(scales)

# ============================================================
# 1. 确认使用已有 tsne
# ============================================================

Reductions(EC_functional_KNN)

# ============================================================
# 2. 功能评分名称
# ============================================================

score_features <- c(
  "Angiogenic_EC_Score1",
  "IFN_responsive_EC_Score1",
  "Homeostatic_EC_Score1",
  "Barrier_EC_Score1",
  "Inflammatory_EC_Score1",
  "Proliferative_EC_Score1",
  "Mural_like_EC_Score1"
)

# ============================================================
# 3. 统一的评分颜色
# ============================================================

score_colors <- c(
  "#C8DDEA",
  "#49A9F5"
)

# ============================================================
# 4. Angiogenic EC Score
# ============================================================

p_angiogenic_score <- FeaturePlot(
  EC_functional_KNN,
  features = "Angiogenic_EC_Score1",
  reduction = "tsne"
) +
  scale_color_gradientn(
    colours = score_colors,
    limits = c(0, 0.6),
    oob = scales::squish
  ) +
  theme_void()

p_angiogenic_score


