)
Tumor_Endothelial


class(Tumor_Endothelial)


colnames(Tumor_Endothelial@meta.data)

table(
  Tumor_Endothelial$Disease,
  useNA = "ifany"
)
table(
  Tumor_Endothelial$Disease.subtype,
  useNA = "ifany"
)
table(
  Tumor_Endothelial$EC.identity,
  useNA = "ifany"
)

# 1. 去掉 IDH mut glioma
Tumor_Endothelial <- subset(
  Tumor_Endothelial,
  subset = Disease.subtype != "IDH mut glioma"
)

# 2. 统一疾病名称
Tumor_Endothelial$Disease_new <- dplyr::case_when(
  Tumor_Endothelial$Disease.subtype == "BrM" ~ "BCBM",
  Tumor_Endothelial$Disease.subtype == "IDH WT glioblastoma" ~ "GBM",
  TRUE ~ NA_character_
)

# 查看当前 reductions
Reductions(Tumor_Endothelial)

# 删除旧的 PCA / Harmony / UMAP
Tumor_Endothelial[["pca"]] <- NULL
Tumor_Endothelial[["harmony"]] <- NULL
Tumor_Endothelial[["umap"]] <- NULL


