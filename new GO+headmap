library(grid)
library(gtable)


# ============================================================
# 1. GO 文字重新换行
# ============================================================

go_text <- setNames(
  vapply(
    module_names,
    function(x) {
      
      terms <- go_top$Description[
        as.character(go_top$subtype) == x
      ]
      
      if (length(terms) == 0) {
        
