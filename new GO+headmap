  )
)


# ------------------------------------------------------------
# 6.6 每个亚型取 Top 5 GO-BP
# ------------------------------------------------------------

go_top <- go_sig %>%
  dplyr::group_by(
    subtype
  ) %>%
  dplyr::slice_min(
    order_by = p.adjust,
    n = 5,
    with_ties = FALSE
  ) %>%
  dplyr::ungroup() %>%
  dplyr::mutate(
    subtype = factor(
      subtype,
      levels = module_names
    )
  ) %>%
  dplyr::arrange(
    subtype,
    p.adjust
  )


