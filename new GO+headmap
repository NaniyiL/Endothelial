# ------------------------------------------------------------
# GO background
# 至少在一个 EC 亚群中达到 25% 检测比例
# ------------------------------------------------------------

pct_by_subtype <- sapply(
  vascular_levels,
  function(x) {
    
    cells <- colnames(EC_functional_KNN)[
      as.character(
        EC_functional_KNN$Vascular_type
      ) == x
    ]
    
    Matrix::rowMeans(
      counts_EC[
        ,
        cells,
        drop = FALSE
      ] > 0
    )
  }
)

go_background <- rownames(counts_EC)[
  apply(
    pct_by_subtype,
    1,
    max
  ) >= 0.25
]

cat("\n================ GO background ================\n")
cat(
  "GO background genes:",
  length(go_background),
  "\n"
)

