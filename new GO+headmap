# ============================================================
# 1. 基本设置
# ============================================================

DefaultAssay(EC_functional_KNN) <- "RNA"

Idents(EC_functional_KNN) <- "Vascular_type"

# 七个 KNN 血管结构亚群
vascular_levels <- c(
  "Angiogenic EC",
  "IFN-responsive EC",
  "Capillary EC",
  "Venous EC",
  "Proliferative EC",
  "Arterial EC 1",
  "Arterial EC 2"
)

vascular_levels <- vascular_levels[
  vascular_levels %in% unique(as.character(EC_functional_KNN$Vascular_type))
]

EC_functional_KNN$Vascular_type <- factor(
  EC_functional_KNN$Vascular_type,
  levels = vascular_levels
)

# ============================================================
# 2. 七个亚群颜色
# ============================================================

vascular_colors <- c(
  "Angiogenic EC"     = "#52B3FF",
  "IFN-responsive EC" = "#9EC5EC",
  "Capillary EC"      = "#CAE691",
  "Venous EC"         = "#FF7A9A",
  "Proliferative EC"  = "#FFE576",
  "Arterial EC 1"     = "#FDBAD0",
  "Arterial EC 2"     = "#C8B5E7"
)

# ============================================================
# 3. 按最终七个亚群计算 marker
# ============================================================

subtype_markers <- Seurat::FindAllMarkers(
  EC_functional_KNN,
  assay = "RNA",
  only.pos = TRUE,
  min.pct = 0.25,
  logfc.threshold = 0.25
)

# 筛选显著阳性 marker
DEGs <- subtype_markers %>%
  dplyr::filter(
    avg_log2FC > 1,
    p_val_adj < 0.05,
    cluster %in% vascular_levels
  ) %>%
  dplyr::mutate(
    cluster = factor(
      as.character(cluster),
      levels = vascular_levels
    )
  ) %>%
  dplyr::arrange(
    cluster,
    dplyr::desc(avg_log2FC)
  )

cat("\n================ Marker counts ================\n")
print(table(DEGs$cluster, useNA = "ifany"))

# ============================================================
# 4. 热图 marker：同一基因只出现一次
#    分配给 avg_log2FC 最大的亚群
# ============================================================

DEGs_heatmap <- DEGs %>%
  dplyr::arrange(dplyr::desc(avg_log2FC)) %>%
  dplyr::distinct(gene, .keep_all = TRUE) %>%
  dplyr::mutate(
    cluster = factor(
      as.character(cluster),
      levels = vascular_levels
    )
  ) %>%
  dplyr::arrange(
    cluster,
    dplyr::desc(avg_log2FC)
