  )
)


# ------------------------------------------------------------
# 6.5 筛选显著 GO-BP
# ------------------------------------------------------------

go_sig <- go_table %>%
  dplyr::filter(
    !is.na(p.adjust),
    p.adjust < 0.05
  )


cat(
  "\n================ SIGNIFICANT GO ================\n"
)

print(
  table(
