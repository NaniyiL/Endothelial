        ),
        collapse = "\n"
      )
    },
    character(1)
  ),
  module_names
)


# ============================================================
# 2. 重新创建 GO panel
# ============================================================

go_heights <- do.call(
  unit.c,
  lapply(
    seq_along(module_sizes),
    function(i) {
      
      h <- unit(
        as.numeric(module_sizes[i]),
        "null"
      )
      
      if (i == 1) {
        
        h
        
      } else {
        
        unit.c(
          unit(4, "bigpts"),
          h
        )
        
      }
    }
  )
)


go_panel <- gtable(
  widths = unit.c(
    unit(0.18, "in"),
    unit(0.06, "in"),
    unit(1, "null")
  ),
  heights = go_heights
)


# ============================================================
# 3. 添加 7 个 GO 模块
# ============================================================

for (i in seq_along(module_names)) {
  
  subtype_i <- module_names[i]
  
  text_i <- go_text[[subtype_i]]
  
  color_i <- vascular_colors[[subtype_i]]
  
  n_lines <- length(
    strsplit(
      text_i,
      "\n",
      fixed = TRUE
    )[[1]]
  )
  
  
  # ----------------------------------------------------------
  # 颜色条
  # ----------------------------------------------------------
  
  module_bar <- grobTree(
    
    rectGrob(
      gp = gpar(
        fill = color_i,
        col = NA
      )
    ),
    
    textGrob(
      paste0(
        "n:",
        module_sizes[i]
      ),
      
      rot = 90,
      
      gp = gpar(
        col = "white",
        fontsize = 8
      )
    )
  )
  
  
  # ----------------------------------------------------------
  # GO text box
  # ----------------------------------------------------------
  
  text_box <- grobTree(
    
    rectGrob(
      gp = gpar(
        fill = "#F4F4F4",
        col = "#BDBDBD",
        lwd = 0.6
      )
    ),
    
    textGrob(
      
      text_i,
      
      x = unit(
        0.03,
        "npc"
      ),
      
      y = unit(
        0.5,
        "npc"
      ),
      
      just = c(
        "left",
        "centre"
      ),
      
      gp = gpar(
        
        col = if (
          text_i == "No significant GO-BP terms"
        ) {
          
          "grey45"
          
        } else {
          
          color_i
          
        },
        
        fontsize = if (
          n_lines > 9
        ) {
          
          8
          
        } else {
          
          9
          
        },
        
        lineheight = 1.1
      )
    )
  )
  
  
  go_panel <- gtable_add_grob(
    
    go_panel,
    
    grobs = list(
      module_bar,
      text_box
    ),
    
    t = rep(
      2 * i - 1,
      2
    ),
    
    l = c(
      1,
      3
    ),
    
    clip = "on"
  )
}


