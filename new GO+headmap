# 6. GO-BP enrichment
#    从 go_genes 开始重新建立 go_text
# ============================================================

library(clusterProfiler)
library(org.Hs.eg.db)
library(dplyr)
library(stringr)


# ------------------------------------------------------------
# 6.1 检查 go_genes
# ------------------------------------------------------------

print(
  sapply(
    go_genes,
    length
  )
)


# ------------------------------------------------------------
# 6.2 GO enrichment
# ------------------------------------------------------------

go_results <- lapply(
  go_genes,
  function(genes_i) {
    
    if (length(genes_i) == 0) {
      return(NULL)
    }
    
    clusterProfiler::enrichGO(
      gene = genes_i,
      universe = go_background,
      OrgDb = org.Hs.eg.db,
      keyType = "SYMBOL",
      ont = "BP",
      pAdjustMethod = "BH",
      pvalueCutoff = 1,
      qvalueCutoff = 1
    )
  }
)

names(go_results) <- names(go_genes)


# ------------------------------------------------------------
# 6.3 转成统一 GO table
# ------------------------------------------------------------

go_table_list <- lapply(
  names(go_results),
  function(x) {
    
    res <- go_results[[x]]
    
    if (is.null(res)) {
      return(NULL)
    }
    
    df <- as.data.frame(res)
    
    if (nrow(df) == 0) {
      return(NULL)
    }
    
    df$subtype <- x
    
    df
  }
)


go_table <- dplyr::bind_rows(
  go_table_list
)


# ------------------------------------------------------------
# 6.4 查看 GO enrichment 结果
# ------------------------------------------------------------

cat(
  "\n================ GO TABLE ================\n"
)

print(
