  dplyr::filter(
    cell_to == "CLEC4E",
    cell_from != "CLEC4E"
  ) %>%
  dplyr::arrange(desc(interaction_score))

CLEC4E_outgoing <- CLEC4E_LR %>%
  dplyr::filter(
    cell_from == "CLEC4E",
    cell_to != "CLEC4E"
  ) %>%
  dplyr::arrange(desc(interaction_score))


