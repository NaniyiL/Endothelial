  "/home/data/t030736/Endothelial/GBM_EC11.rds"
)

EC_old <- readRDS(
  "/home/data/t030736/Endothelial/EC_Vascular_KNN.rds"
)

# ============================================================
# 2. Figure 1 注释
# ============================================================

obj$Figure1_type <- NA_character_

obj$Figure1_type[obj$celltype.1 %in%
                   c("Prol.tumor cell", "Tumor cell")] <- "Tumor"

obj$Figure1_type[obj$celltype.1 == "Myeloid cell"] <- "Myeloid"
obj$Figure1_type[obj$celltype.1 == "NK/T cell"] <- "T/NK"
obj$Figure1_type[obj$celltype.1 == "Oligodendrocyte"] <- "Glial"
obj$Figure1_type[obj$celltype.1 == "Stromal cell"] <- "Fibroblast/Mural"

# ============================================================
# 3. CLEC4E+ EC
# ============================================================

CLEC4E_new <- subset(
  GBM_EC11,
  subset = CLEC4E > 0
)

CLEC4E_old <- subset(
  EC_old,
  subset = Disease == "GBM" &
    Vascular_type == "Capillary EC" &
    CLEC4E > 0
)

# ============================================================
# 4. 其他细胞
# ============================================================

Tumor <- subset(obj, subset = Figure1_type == "Tumor")
Myeloid <- subset(obj, subset = Figure1_type == "Myeloid")
TNK <- subset(obj, subset = Figure1_type == "T/NK")
Glial <- subset(obj, subset = Figure1_type == "Glial")
FibroMural <- subset(obj, subset = Figure1_type == "Fibroblast/Mural")

# ============================================================
# 5. 每组最多1000
# ============================================================

set.seed(123)

sample_cells <- function(x, n = 1000) {
  if (ncol(x) > n) {
    x[, sample(colnames(x), n)]
  } else {
    x
  }
}

Tumor <- sample_cells(Tumor)
Myeloid <- sample_cells(Myeloid)
TNK <- sample_cells(TNK)
Glial <- sample_cells(Glial)
FibroMural <- sample_cells(FibroMural)
CLEC4E_old <- sample_cells(CLEC4E_old)
CLEC4E_new <- sample_cells(CLEC4E_new)

# ============================================================
# 6. counts
# ============================================================

get_counts <- function(x) {
  GetAssayData(
    x,
    assay = "RNA",
    layer = "counts"
  )
}

mat_Tumor <- get_counts(Tumor)
mat_Myeloid <- get_counts(Myeloid)
mat_TNK <- get_counts(TNK)
mat_Glial <- get_counts(Glial)
mat_FibroMural <- get_counts(FibroMural)

mat_CLEC4E_old <- get_counts(CLEC4E_old)
mat_CLEC4E_new <- get_counts(CLEC4E_new)

# ============================================================
# 7. 合并 CLEC4E EC
# ============================================================

genes_ec <- intersect(
  rownames(mat_CLEC4E_old),
  rownames(mat_CLEC4E_new)
)

mat_CLEC4E <- cbind(
  mat_CLEC4E_old[genes_ec, , drop = FALSE],
  mat_CLEC4E_new[genes_ec, , drop = FALSE]
)

# ============================================================
# 8. 统一基因
# ============================================================

genes <- Reduce(
  intersect,
  list(
    rownames(mat_Tumor),
    rownames(mat_Myeloid),
    rownames(mat_TNK),
    rownames(mat_Glial),
    rownames(mat_FibroMural),
    rownames(mat_CLEC4E)
  )
)

mat_Tumor <- mat_Tumor[genes, , drop = FALSE]
mat_Myeloid <- mat_Myeloid[genes, , drop = FALSE]
mat_TNK <- mat_TNK[genes, , drop = FALSE]
mat_Glial <- mat_Glial[genes, , drop = FALSE]
mat_FibroMural <- mat_FibroMural[genes, , drop = FALSE]
mat_CLEC4E <- mat_CLEC4E[genes, , drop = FALSE]

# ============================================================
# 9. iTALK matrix
# ============================================================

colnames(mat_Tumor) <- paste0("Tumor_", seq_len(ncol(mat_Tumor)))
colnames(mat_Myeloid) <- paste0("Myeloid_", seq_len(ncol(mat_Myeloid)))
colnames(mat_TNK) <- paste0("TNK_", seq_len(ncol(mat_TNK)))
colnames(mat_Glial) <- paste0("Glial_", seq_len(ncol(mat_Glial)))
colnames(mat_FibroMural) <- paste0(
  "FibroMural_", seq_len(ncol(mat_FibroMural))
)
colnames(mat_CLEC4E) <- paste0(
  "CLEC4E_EC_", seq_len(ncol(mat_CLEC4E))
)

expr <- cbind(
  mat_Tumor,
  mat_Myeloid,
  mat_TNK,
  mat_Glial,
  mat_FibroMural,
  mat_CLEC4E
)

data <- as.data.frame(t(as.matrix(expr)))

data$cell_type <- sub(
  "_.*",
  "",
  rownames(data)
)

data$compare_group <- "GBM"


















expr_data <- data %>%
  dplyr::select(-cell_type, -compare_group)

highly_exprs_genes <- rawParse(
  expr_data,
  top_genes = 50,
  stats = "mean"
)

head(highly_exprs_genes)
