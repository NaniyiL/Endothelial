  "FibroMural" = "#9ED9AF",
  "CLEC4E"     = "#52B3FF"
)


# ============================================================
# 3. 全部 LR 分析
# ============================================================

res_list <- list()

for (comm_type in comm_list) {
  
  res_cat <- FindLR(
    highly_exprs_genes,
    datatype = "mean count",
    comm_type = comm_type
  )
  
  res_cat <- res_cat[
    order(
      res_cat$cell_from_mean_exprs *
        res_cat$cell_to_mean_exprs,
      decreasing = TRUE
    ),
  ]
  
  res_list[[comm_type]] <- res_cat
}

res <- do.call(rbind, res_list)

res <- na.omit(res)


# ============================================================
# 4. 查看全部 LR 结果
# ============================================================

dim(res)

table(res$comm_type)

head(res, 20)


# ============================================================
# 5. 提取 CLEC4E+ EC 相关 LR
# ============================================================

CLEC4E_LR <- res[
  res$cell_from == "CLEC4E" |
    res$cell_to == "CLEC4E",
]

CLEC4E_LR$interaction_score <-
  CLEC4E_LR$cell_from_mean_exprs *
  CLEC4E_LR$cell_to_mean_exprs

CLEC4E_LR$other_cell <- ifelse(
  CLEC4E_LR$cell_from == "CLEC4E",
  CLEC4E_LR$cell_to,
  CLEC4E_LR$cell_from
)


# ============================================================
# 6. Incoming / Outgoing
# ============================================================

