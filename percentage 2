library(Seurat)
library(SeuratObject)
library(SCP)

# ------------------------------------------------------------
# 1. 读取 Query 和 Reference
# ------------------------------------------------------------

EC_functional_KNN <- readRDS(
  "/home/data/t030736/Endothelial/EC_functional_annotated_noCluster12.rds"
)

EC_reference <- readRDS(
  "/home/data/t030736/Endothelial/Endothelial.rds"
)

DefaultAssay(EC_functional_KNN) <- "RNA"
DefaultAssay(EC_reference) <- "RNA"


# ------------------------------------------------------------
# 2. 修改 SCP::RunKNNPredict，使其兼容 Seurat v5
# ------------------------------------------------------------

RunKNNPredict_v5 <- SCP::RunKNNPredict

replace_slot_with_layer <- function(x) {
  
  if (is.call(x)) {
    
    fn <- tryCatch(
      as.character(x[[1]])[1],
      error = function(e) ""
    )
    
    if (fn %in% c("GetAssayData", "AverageExpression")) {
      
      nms <- names(x)
      
      if (!is.null(nms)) {
        idx <- which(nms == "slot")
        
        if (length(idx) > 0) {
          nms[idx] <- "layer"
          names(x) <- nms
        }
      }
    }
    
    for (i in seq_along(x)) {
      x[[i]] <- replace_slot_with_layer(x[[i]])
    }
  }
  
  x
}

body(RunKNNPredict_v5) <- replace_slot_with_layer(
  body(RunKNNPredict_v5)
)


# ------------------------------------------------------------
# 3. 删除旧版 @tools 写入，避免 Seurat v5 报错
# ------------------------------------------------------------

knn_lines <- deparse(body(RunKNNPredict_v5))

knn_lines <- knn_lines[
  !grepl(
    "srt_query@tools\\[\\[paste0\\(prefix, \"_classification\"\\)\\]\\] <- result",
    knn_lines
  )
]

body(RunKNNPredict_v5) <- parse(
  text = paste(knn_lines, collapse = "\n")
)[[1]]


# ------------------------------------------------------------
# 4. KNN prediction
# ------------------------------------------------------------

EC_functional_KNN <- RunKNNPredict_v5(
  srt_query = EC_functional_KNN,
  srt_ref = EC_reference,
  ref_group = "EC.identity",
  filter_lowfreq = 20
)


# ------------------------------------------------------------
# 5. 查看 KNN 结果
# ------------------------------------------------------------

table(
  EC_functional_KNN$KNNPredict_classification,
  useNA = "ifany"
)



