library(dplyr)

# Slingshot pseudotime
pt_all <- slingPseudotime(sce)

# 三条 lineage
pt_L1 <- pt_all[, 1]
pt_L2 <- pt_all[, 2]
pt_L3 <- pt_all[, 3]

# 所有基因
genes_all <- rownames(sce)

# ------------------------------------------------------------
# 每条 lineage 分别计算 Spearman rho
# ------------------------------------------------------------

calc_rho <- function(expr, pt) {
  
  cells <- names(pt)[!is.na(pt)]
  
  expr_use <- expr[, cells, drop = FALSE]
  pt_use <- pt[cells]
  
  apply(
    expr_use,
    1,
    function(x) {
      suppressWarnings(
        cor(
          x,
          pt_use,
          method = "spearman"
        )
      )
    }
  )
}

# 使用 logcounts
expr_all <- assay(
  sce,
  "logcounts"
)

rho_L1 <- calc_rho(
  expr_all,
  pt_L1
)

rho_L2 <- calc_rho(
  expr_all,
  pt_L2
)

rho_L3 <- calc_rho(
  expr_all,
  pt_L3
)


# ============================================================
# Combine three lineages
# ============================================================

rho_df <- data.frame(
  Gene = genes_all,
  Lineage1 = rho_L1[genes_all],
  Lineage2 = rho_L2[genes_all],
  Lineage3 = rho_L3[genes_all]
)

rho_df$Dynamic_score <- apply(
  abs(
    rho_df[, c(
      "Lineage1",
      "Lineage2",
      "Lineage3"
    )]
  ),
  1,
  max,
  na.rm = TRUE
)

rho_df <- rho_df %>%
  arrange(
    desc(Dynamic_score)
  )

