  c(
    "^MT-",
    "^RPL",
    "^RPS",
    "^MTRNR",
    "^HLA-",
    "^B2M$",
    "^IGH",
    "^IGK",
    "^IGL",
    "^CCL3$",
    "^CCL4$",
    "^S100A9$"
  ),
  collapse = "|"
)

rho_filtered <- rho_df %>%
  filter(
    !grepl(exclude_pattern, Gene)
  )

# 2. 三条 lineage 综合
rho_filtered$Mean_rho <- rowMeans(
  rho_filtered[, c(
    "Lineage1",
    "Lineage2",
    "Lineage3"
  )],
  na.rm = TRUE
)

