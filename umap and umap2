# ============================================================
# 重新构建 Seurat v5 兼容版 RunKNNPredict
# ============================================================

library(Seurat)
library(SeuratObject)
library(SCP)


# ------------------------------------------------------------
# 1. 原始函数
# ------------------------------------------------------------

RunKNNPredict_v5 <- SCP::RunKNNPredict


# ------------------------------------------------------------
# 2. 递归替换 slot 参数名
# ------------------------------------------------------------

replace_slot_with_layer <- function(x) {
  
  if (is.call(x)) {
    
    # 当前表达式的函数名
    fn <- if (length(x) >= 1) {
      tryCatch(
        as.character(x[[1]])[1],
        error = function(e) ""
      )
    } else {
      ""
    }
    
    # --------------------------------------------------------
    # GetAssayData
    # --------------------------------------------------------
    
    if (identical(fn, "GetAssayData")) {
      
      nms <- names(x)
      
      if (!is.null(nms)) {
        
        idx <- which(nms == "slot")
        
        if (length(idx) > 0) {
          nms[idx] <- "layer"
          names(x) <- nms
        }
      }
    }
    
    # --------------------------------------------------------
    # AverageExpression
    # --------------------------------------------------------
    
    if (identical(fn, "AverageExpression")) {
      
      nms <- names(x)
      
      if (!is.null(nms)) {
        
        idx <- which(nms == "slot")
        
        if (length(idx) > 0) {
          nms[idx] <- "layer"
          names(x) <- nms
        }
      }
    }
    
    # --------------------------------------------------------
    # 继续递归
    # --------------------------------------------------------
    
    for (i in seq_along(x)) {
      x[[i]] <- replace_slot_with_layer(x[[i]])
    }
  }
  
  x
}


# ------------------------------------------------------------
# 3. 修改函数体
# ------------------------------------------------------------

body(RunKNNPredict_v5) <- replace_slot_with_layer(
  body(RunKNNPredict_v5)
)


# ============================================================
# 4. 文本检查
# ============================================================

body_text <- paste(
  deparse(body(RunKNNPredict_v5)),
  collapse = "\n"
)

cat("\n================ GetAssayData / AverageExpression ================\n")

lines_check <- grep(
  "GetAssayData|AverageExpression",
  strsplit(body_text, "\n")[[1]],
  value = TRUE
)

cat(
  lines_check,
  sep = "\n"
)


# ============================================================
# 5. 判断是否仍然存在 slot
# ============================================================

cat("\n\n================ SLOT CHECK ================\n")

cat(
  "函数体中是否仍存在 'slot = \"data\"'：",
  grepl(
    'slot\\s*=\\s*["\']data["\']',
    body_text,
    perl = TRUE
  ),
  "\n"
)

cat(
  "函数体中是否存在 'layer = \"data\"'：",
  grepl(
    'layer\\s*=\\s*["\']data["\']',
    body_text,
    perl = TRUE
  ),
  "\n"
)




