# ============================================================
# Vascular EC 各 Disease 细胞比例
# ============================================================

library(dplyr)
library(ggplot2)
library(ggalluvial)

# 1. 计算比例
vascular_prop <- EC_functional_KNN@meta.data %>%
  filter(
    !is.na(Disease),
    !is.na(Vascular_type)
  ) %>%
  count(
    Disease,
    Vascular_type,
    name = "n"
  ) %>%
  group_by(Disease) %>%
  mutate(
    prop = n / sum(n) * 100
  ) %>%
  ungroup()


# 2. Disease 顺序
vascular_prop$Disease <- factor(
  vascular_prop$Disease,
  levels = c(
    "GBM",
    "BCBM",
    "NSCLC-BM",
    "Melanoma-BM",
    "CRC-BM",
    "ESCC-BM",
    "HCC-BM",
    "Sarcoma-BM",
    "Other-BM"
  )
)


# 3. Vascular type 顺序
vascular_prop$Vascular_type <- factor(
  vascular_prop$Vascular_type,
  levels = c(
    "Angiogenic EC",
    "IFN-responsive EC",
    "Capillary EC",
    "Venous EC",
    "Proliferative EC",
    "Arterial EC 1",
    "Arterial EC 2"
  )
)


# ============================================================
# 4. 绘制比例图
# ============================================================

p_Vascular_proportion <- ggplot(
  vascular_prop,
  aes(
    x = Disease,
    y = prop,
    fill = Vascular_type,
    alluvium = Vascular_type,
    stratum = Vascular_type
  )
) +
  geom_col(
    position = "stack",
    width = 0.8
  ) +
  geom_alluvium(
    aes(stratum = Vascular_type),
    width = 0.5,
    alpha = 0.2,
    color = "white",
    linewidth = 0.8,
    curve_type = "sigmoid"
  ) +
  geom_stratum(
    width = 0.8,
    alpha = 0.7,
    color = "white"
  ) +
  scale_fill_manual(
    values = vascular_colors
  ) +
  scale_y_continuous(
    expand = c(0, 0),
    limits = c(0, 100)
  ) +
  labs(
    x = NULL,
    y = "Percentage of cells",
    title = NULL,
    fill = NULL
  ) +
  theme_classic() +
  theme(
    axis.text.x = element_text(
      angle = 45,
      hjust = 1,
      size = 14,
      color = "black"
    ),
    axis.text.y = element_text(
      size = 14,
      color = "black"
    ),
    axis.title.y = element_text(
      size = 18
    ),
    legend.text = element_text(
      size = 12
    ),
    legend.title = element_text(
      size = 14
    )
  )

p_Vascular_proportion


ggsave(
  "/home/data/t030736/Endothelial/EC_Vascular_Disease_Proportion.pdf",
  p_Vascular_proportion,
  width = 12,
  height = 7
)
