)

ggsave(
  filename = pdf_file,
  
  plot = p_EC_final,
  
  width = 11.0,
  
  height = 10.5,
  
  units = "in",
  
  device = cairo_pdf,
  
  limitsize = FALSE
)

cat(
  "\n============================================================\n",
  "EC Marker + GO-BP Top6 figure saved:\n",
  pdf_file,
  "\n",
  "============================================================\n"
